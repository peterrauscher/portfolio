# Now section — server-only (never commit real values)

# Goodreads numeric user id (from profile URL /user/show/XXXX)
GOODREADS_USER_ID=

# Trakt.tv API app client id from https://trakt.tv/oauth/applications
# Username defaults to peterrauscher if unset.
TRAKT_CLIENT_ID=
TRAKT_USERNAME=peterrauscher

# Optional — poster art for Watching widget (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
